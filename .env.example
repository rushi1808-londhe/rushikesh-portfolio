# ───────── PostgreSQL ─────────
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=Portf0lio_Db_2026!

# ───────── Backend ─────────
# HMAC-SHA512 signing key — must be at least 64 characters. CHANGE IN PRODUCTION.
JWT_SECRET=b7f3c9e1a4d8526f0e9b1c7a3d5f8e2b6a9c4d1e7f0a3b5c8d2e6f9a1b4c7d0e3f6a9b2c5d8e1f4a7b0c3d6e9f2a5b8c1d4e7f0
# Admin session lifetime (2 hours)
JWT_EXPIRATION_MS=7200000
# Admin account is created/updated on backend startup from these values. CHANGE IN PRODUCTION.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Rushikesh@Admin2026
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=15MB

# ───────── Security ─────────
# true = session cookie only sent over HTTPS. Set true in production (behind TLS).
COOKIE_SECURE=false
# Swagger UI / OpenAPI docs. Set false in production.
SWAGGER_ENABLED=true
# Brute-force protection: lock an account after N failures for this long.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m
# Per-IP limits
LOGIN_RATE_PER_IP=10
RATE_LIMIT_READS_PER_MIN=300
RATE_LIMIT_WRITES_PER_MIN=60
RATE_LIMIT_CONTACT_PER_HOUR=5
RATE_LIMIT_UPLOADS_PER_HOUR=30

# ───────── Frontend ─────────
FRONTEND_PORT=3000
# Set to true after placing frontend/src/assets/character.mp4 (then rebuild the frontend).
USE_VIDEO_HERO=false
