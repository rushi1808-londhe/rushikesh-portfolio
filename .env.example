# Copy to .env and replace every CHANGE_ME value. Never commit .env.

# ───────── PostgreSQL ─────────
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
# generate: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_db_password

# ───────── Backend ─────────
# HMAC-SHA512 signing key — must be at least 64 characters (backend refuses to start otherwise).
# generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME
# Admin session lifetime (2 hours)
JWT_EXPIRATION_MS=7200000
# Admin account is created/updated on backend startup from these values.
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_USERNAME=CHANGE_ME_admin
ADMIN_PASSWORD=CHANGE_ME
# Production: your real origin(s), e.g. https://example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=15MB

# ───────── Security ─────────
# true = session cookie only sent over HTTPS. Set true in production (behind TLS).
COOKIE_SECURE=false
# Swagger UI / OpenAPI docs. Set false in production.
SWAGGER_ENABLED=true
# Brute-force protection: lock an account after N failures for this long.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m
# Per-IP limits
LOGIN_RATE_PER_IP=10
RATE_LIMIT_READS_PER_MIN=300
RATE_LIMIT_WRITES_PER_MIN=60
RATE_LIMIT_CONTACT_PER_HOUR=5
RATE_LIMIT_UPLOADS_PER_HOUR=30

# ───────── Frontend ─────────
FRONTEND_PORT=3000
# Set to true after placing frontend/src/assets/character.mp4 (then rebuild the frontend).
USE_VIDEO_HERO=false
